# App
APP_URL=https://your-app.vercel.app
DEMO_MODE=0

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web Push: generate with `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Random secrets: `openssl rand -hex 32`
TOKEN_ENCRYPTION_KEY=
CRON_SECRET=

# Feedback email (Resend). Sign up at resend.com with the inbox below, create an API key.
RESEND_API_KEY=
FEEDBACK_TO=pcrawfor@usc.edu

# AI recap (Google AI Studio key; free tier works)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
